{
  "entities": {
    "Produto": {
      "title": "Produto",
      "description": "Item comercializado na loja e gerenciado no estoque",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "nome": { "type": "string", "maxLength": 120 },
        "unidade": { "type": "string", "maxLength": 40 },
        "descricao": { "type": "string", "maxLength": 300 },
        "preco": { "type": "number" },
        "custo": { "type": "number" },
        "estoque": { "type": "number" },
        "ativo": { "type": "boolean" },
        "ordem": { "type": "number" },
        "ts": { "type": "number" }
      },
      "required": ["nome", "preco"]
    },
    "Venda": {
      "title": "Venda",
      "description": "Registro de pedido ou venda avulsa",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "ts": { "type": "number" },
        "cliente": { "type": "object" },
        "clienteId": { "type": "string", "maxLength": 128 },
        "itens": { "type": "array" },
        "total": { "type": "number" },
        "forma": { "type": "string", "maxLength": 40 },
        "pago": { "type": "boolean" },
        "pagoTs": { "type": "number" },
        "valorPago": { "type": "number" },
        "parcialTs": { "type": "number" },
        "origem": { "type": "string", "maxLength": 40 },
        "status": { "type": "string", "maxLength": 40 },
        "ordemRota": { "type": "number" },
        "entregueTs": { "type": "number" },
        "obs": { "type": "string", "maxLength": 500 },
        "clienteInformouPix": { "type": "boolean" }
      },
      "required": ["ts", "total"]
    },
    "Compra": {
      "title": "Compra",
      "description": "Registro de compra na roça de fornecedores",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "ts": { "type": "number" },
        "fornecedor": { "type": "string", "maxLength": 120 },
        "fornecedorId": { "type": "string", "maxLength": 128 },
        "itens": { "type": "array" },
        "total": { "type": "number" },
        "forma": { "type": "string", "maxLength": 40 },
        "pago": { "type": "boolean" },
        "valorPago": { "type": "number" },
        "parcialTs": { "type": "number" },
        "obs": { "type": "string", "maxLength": 500 }
      },
      "required": ["ts", "fornecedor", "total"]
    },
    "Despesa": {
      "title": "Despesa",
      "description": "Gastos operacionais e despesas gerais",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "ts": { "type": "number" },
        "descricao": { "type": "string", "maxLength": 200 },
        "categoria": { "type": "string", "maxLength": 80 },
        "valor": { "type": "number" },
        "pago": { "type": "boolean" },
        "fixa": { "type": "boolean" },
        "forma": { "type": "string", "maxLength": 40 },
        "recorrente": { "type": "boolean" }
      },
      "required": ["descricao", "valor"]
    },
    "Noticia": {
      "title": "Noticia",
      "description": "Banner informativo e promoções na loja",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "ts": { "type": "number" },
        "titulo": { "type": "string", "maxLength": 100 },
        "texto": { "type": "string", "maxLength": 400 },
        "etiqueta": { "type": "string", "maxLength": 50 },
        "cor": { "type": "string", "maxLength": 50 },
        "icone": { "type": "string", "maxLength": 50 },
        "fotoUrl": { "type": "string", "maxLength": 500 },
        "botao": { "type": "object" },
        "ativa": { "type": "boolean" },
        "fixa": { "type": "boolean" },
        "inicio": { "type": "string", "maxLength": 30 },
        "fim": { "type": "string", "maxLength": 30 },
        "views": { "type": "number" },
        "clicks": { "type": "number" }
      },
      "required": ["titulo", "texto"]
    },
    "Cliente": {
      "title": "Cliente",
      "description": "Cadastro de clientes e compradores",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "ts": { "type": "number" },
        "nome": { "type": "string", "maxLength": 120 },
        "tipo": { "type": "string", "maxLength": 30 },
        "telefone": { "type": "string", "maxLength": 30 },
        "email": { "type": "string", "maxLength": 120 },
        "cep": { "type": "string", "maxLength": 20 },
        "endereco": { "type": "string", "maxLength": 200 },
        "numero": { "type": "string", "maxLength": 30 },
        "complemento": { "type": "string", "maxLength": 100 },
        "bairro": { "type": "string", "maxLength": 100 },
        "cidade": { "type": "string", "maxLength": 100 },
        "referencia": { "type": "string", "maxLength": 200 },
        "obs": { "type": "string", "maxLength": 500 }
      },
      "required": ["nome"]
    },
    "Fornecedor": {
      "title": "Fornecedor",
      "description": "Cadastro de produtores rurais e fornecedores",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "ts": { "type": "number" },
        "nome": { "type": "string", "maxLength": 120 },
        "tipo": { "type": "string", "maxLength": 40 },
        "telefone": { "type": "string", "maxLength": 30 },
        "cep": { "type": "string", "maxLength": 20 },
        "endereco": { "type": "string", "maxLength": 200 },
        "numero": { "type": "string", "maxLength": 30 },
        "bairro": { "type": "string", "maxLength": 100 },
        "cidade": { "type": "string", "maxLength": 100 },
        "referencia": { "type": "string", "maxLength": 200 },
        "produtos": { "type": "string", "maxLength": 300 },
        "pix": { "type": "string", "maxLength": 100 },
        "banco": { "type": "string", "maxLength": 100 },
        "agencia": { "type": "string", "maxLength": 30 },
        "conta": { "type": "string", "maxLength": 30 },
        "tipoConta": { "type": "string", "maxLength": 30 },
        "titular": { "type": "string", "maxLength": 120 },
        "docTitular": { "type": "string", "maxLength": 50 },
        "obs": { "type": "string", "maxLength": 500 }
      },
      "required": ["nome"]
    },
    "Mensagem": {
      "title": "Mensagem",
      "description": "Mensagem de atendimento entre cliente e gestão",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "ts": { "type": "number" },
        "conversaId": { "type": "string", "maxLength": 128 },
        "de": { "type": "string", "maxLength": 30 },
        "texto": { "type": "string", "maxLength": 2000 },
        "anexo": { "type": "object" },
        "lida": { "type": "boolean" },
        "clienteId": { "type": "string", "maxLength": 128 }
      },
      "required": ["conversaId", "de", "ts"]
    },
    "Notificacao": {
      "title": "Notificacao",
      "description": "Avisos de sistema e pedidos",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "ts": { "type": "number" },
        "tipo": { "type": "string", "maxLength": 40 },
        "titulo": { "type": "string", "maxLength": 120 },
        "texto": { "type": "string", "maxLength": 400 },
        "lida": { "type": "boolean" }
      },
      "required": ["titulo", "texto", "ts"]
    },
    "Categoria": {
      "title": "Categoria",
      "description": "Categorias de despesas da gestão",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "nome": { "type": "string", "maxLength": 80 },
        "cor": { "type": "string", "maxLength": 40 },
        "ordem": { "type": "number" }
      },
      "required": ["nome"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Mapeamento de administradores e equipe da gestão",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 120 },
        "nome": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "maxLength": 30 },
        "ativo": { "type": "boolean" },
        "conviteId": { "type": "string", "maxLength": 64 },
        "criadoPor": { "type": "string", "maxLength": 128 },
        "criadoPorEmail": { "type": "string", "maxLength": 120 },
        "ts": { "type": "number" }
      },
      "required": ["role"]
    },
    "Convite": {
      "title": "Convite",
      "description": "Códigos e links de convite para novos membros da equipe de gestão",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "codigo": { "type": "string", "maxLength": 64 },
        "email": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "maxLength": 30 },
        "ativo": { "type": "boolean" },
        "criadoPor": { "type": "string", "maxLength": 128 },
        "criadoPorEmail": { "type": "string", "maxLength": 120 },
        "criadoEm": { "type": "number" },
        "usadoPorUid": { "type": "string", "maxLength": 128 },
        "usadoPorEmail": { "type": "string", "maxLength": 120 },
        "usadoEm": { "type": "number" }
      },
      "required": ["codigo", "role", "ativo", "criadoEm"]
    },
    "Usuario": {
      "title": "Usuario",
      "description": "Perfil de usuário da plataforma",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 120 },
        "nome": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "maxLength": 30 },
        "clienteId": { "type": "string", "maxLength": 128 }
      },
      "required": ["role"]
    },
    "TestDoc": {
      "title": "TestDoc",
      "description": "Documento para verificação de conectividade",
      "type": "object",
      "properties": {
        "ok": { "type": "boolean" }
      }
    }
  },
  "firestore": {
    "/produtos/{produtoId}": {
      "schema": { "$ref": "#/entities/Produto" },
      "description": "Coleção de produtos à venda"
    },
    "/vendas/{vendaId}": {
      "schema": { "$ref": "#/entities/Venda" },
      "description": "Pedidos e vendas registradas"
    },
    "/compras/{compraId}": {
      "schema": { "$ref": "#/entities/Compra" },
      "description": "Compras realizadas com fornecedores da roça"
    },
    "/despesas/{despesaId}": {
      "schema": { "$ref": "#/entities/Despesa" },
      "description": "Despesas operacionais e financeiras"
    },
    "/noticias/{noticiaId}": {
      "schema": { "$ref": "#/entities/Noticia" },
      "description": "Banners de notícias e promoções"
    },
    "/clientes/{clienteId}": {
      "schema": { "$ref": "#/entities/Cliente" },
      "description": "Clientes da loja"
    },
    "/fornecedores/{fornecedorId}": {
      "schema": { "$ref": "#/entities/Fornecedor" },
      "description": "Fornecedores e produtores"
    },
    "/mensagens/{mensagemId}": {
      "schema": { "$ref": "#/entities/Mensagem" },
      "description": "Mensagens de conversas de atendimento"
    },
    "/notificacoes/{notificacaoId}": {
      "schema": { "$ref": "#/entities/Notificacao" },
      "description": "Notificações internas"
    },
    "/categorias/{categoriaId}": {
      "schema": { "$ref": "#/entities/Categoria" },
      "description": "Categorias de despesas"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Gestores e administradores autorizados"
    },
    "/convites/{conviteId}": {
      "schema": { "$ref": "#/entities/Convite" },
      "description": "Convites de acesso para a equipe de gestão"
    },
    "/usuarios/{userId}": {
      "schema": { "$ref": "#/entities/Usuario" },
      "description": "Contas de acesso dos usuários"
    },
    "/test/{testId}": {
      "schema": { "$ref": "#/entities/TestDoc" },
      "description": "Verificação de conectividade"
    }
  }
}
