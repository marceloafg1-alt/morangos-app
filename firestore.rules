rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isMaster() {
      return isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email == 'marcelo.afg1@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function adminDocPath() {
      return /databases/$(database)/documents/admins/$(request.auth.uid);
    }

    function hasActiveAdminDoc() {
      return isSignedIn()
        && exists(adminDocPath())
        && (!('ativo' in get(adminDocPath()).data) || get(adminDocPath()).data.ativo == true)
        && get(adminDocPath()).data.role in ['master', 'admin', 'operador'];
    }

    function isAdmin() {
      return isMaster() || hasActiveAdminDoc();
    }

    function isTeamManager() {
      return isMaster() || (
        isSignedIn()
        && exists(adminDocPath())
        && (!('ativo' in get(adminDocPath()).data) || get(adminDocPath()).data.ativo == true)
        && get(adminDocPath()).data.role in ['master', 'admin']
      );
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function optStr(d, k, maxLen) {
      return !(k in d) || d[k] == null || (d[k] is string && d[k].size() <= maxLen);
    }

    function optNum(d, k) {
      return !(k in d) || d[k] == null || d[k] is number;
    }

    function optBool(d, k) {
      return !(k in d) || d[k] == null || d[k] is bool;
    }

    function optList(d, k, maxLen) {
      return !(k in d) || d[k] == null || (d[k] is list && d[k].size() <= maxLen);
    }

    function optMap(d, k) {
      return !(k in d) || d[k] == null || d[k] is map;
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidAdminDoc(d) {
      return d.keys().hasOnly(['uid', 'email', 'nome', 'role', 'ativo', 'conviteId', 'criadoPor', 'criadoPorEmail', 'ts', 'id'])
        && 'role' in d && d.role in ['master', 'admin', 'operador']
        && optStr(d, 'uid', 128)
        && optStr(d, 'email', 120)
        && optStr(d, 'nome', 120)
        && optBool(d, 'ativo')
        && optStr(d, 'conviteId', 64)
        && optStr(d, 'criadoPor', 128)
        && optStr(d, 'criadoPorEmail', 120)
        && optNum(d, 'ts')
        && optStr(d, 'id', 128);
    }

    function isValidInviteClaim(adminId) {
      let d = request.resource.data;
      let invPath = /databases/$(database)/documents/convites/$(d.conviteId);
      return isUser(adminId)
        && 'conviteId' in d && d.conviteId is string && isValidId(d.conviteId)
        && exists(invPath)
        && get(invPath).data.ativo == true
        && getAfter(invPath).data.ativo == false
        && getAfter(invPath).data.usadoPorUid == request.auth.uid
        && (!('email' in get(invPath).data) || !(get(invPath).data.email is string) || get(invPath).data.email == '' || (
          request.auth.token.email != null
          && request.auth.token.email_verified == true
          && request.auth.token.email.lower() == get(invPath).data.email.lower()
        ))
        && d.role in ['admin', 'operador']
        && d.role == get(invPath).data.role
        && (!('ativo' in d) || d.ativo == true)
        && isValidAdminDoc(d);
    }

    function isValidConvite(d) {
      return d.keys().hasOnly(['id', 'codigo', 'email', 'role', 'ativo', 'criadoPor', 'criadoPorEmail', 'criadoEm', 'usadoPorUid', 'usadoPorEmail', 'usadoEm'])
        && 'codigo' in d && d.codigo is string && d.codigo.size() >= 4 && d.codigo.size() <= 64
        && 'role' in d && d.role in ['admin', 'operador']
        && 'ativo' in d && d.ativo is bool
        && 'criadoEm' in d && d.criadoEm is number
        && optStr(d, 'id', 64)
        && optStr(d, 'email', 120)
        && optStr(d, 'criadoPor', 128)
        && optStr(d, 'criadoPorEmail', 120)
        && optStr(d, 'usadoPorUid', 128)
        && optStr(d, 'usadoPorEmail', 120)
        && optNum(d, 'usadoEm');
    }

    function isValidConviteSelfClaim() {
      let d = request.resource.data;
      return isSignedIn()
        && resource.data.ativo == true
        && (!('email' in resource.data) || !(resource.data.email is string) || resource.data.email == '' || (
          request.auth.token.email != null
          && request.auth.token.email_verified == true
          && request.auth.token.email.lower() == resource.data.email.lower()
        ))
        && d.diff(resource.data).affectedKeys().hasOnly(['ativo', 'usadoPorUid', 'usadoPorEmail', 'usadoEm'])
        && d.ativo == false
        && d.usadoPorUid == request.auth.uid
        && optStr(d, 'usadoPorEmail', 120)
        && optNum(d, 'usadoEm');
    }

    function isValidUsuario(d) {
      return d.keys().hasOnly(['id', 'email', 'nome', 'role', 'clienteId', 'ts'])
        && 'role' in d && d.role in ['master', 'admin', 'operador', 'cliente']
        && optStr(d, 'id', 128)
        && optStr(d, 'email', 120)
        && optStr(d, 'nome', 120)
        && optStr(d, 'clienteId', 128)
        && optNum(d, 'ts');
    }

    function isValidProduto(d) {
      return optStr(d, 'id', 128)
        && optStr(d, 'nome', 120)
        && optStr(d, 'unidade', 40)
        && optStr(d, 'descricao', 300)
        && optNum(d, 'preco')
        && optNum(d, 'custo')
        && optNum(d, 'estoque')
        && optBool(d, 'ativo')
        && optNum(d, 'ordem')
        && optNum(d, 'ts');
    }

    function isValidNoticia(d) {
      return optStr(d, 'id', 128)
        && optStr(d, 'titulo', 140)
        && optStr(d, 'texto', 600)
        && optStr(d, 'etiqueta', 60)
        && optStr(d, 'cor', 50)
        && optStr(d, 'icone', 50)
        && optStr(d, 'fotoUrl', 500)
        && optBool(d, 'ativa')
        && optBool(d, 'fixa')
        && optNum(d, 'ts');
    }

    function isValidCategoria(d) {
      return optStr(d, 'id', 128)
        && optStr(d, 'nome', 80)
        && optStr(d, 'cor', 40)
        && optStr(d, 'icone', 40)
        && optNum(d, 'ordem')
        && optBool(d, 'apagada')
        && optNum(d, 'ts');
    }

    function isValidDespesa(d) {
      return optStr(d, 'id', 128)
        && optNum(d, 'ts')
        && optStr(d, 'descricao', 200)
        && optStr(d, 'categoria', 80)
        && optNum(d, 'valor')
        && optBool(d, 'pago')
        && optBool(d, 'fixa')
        && optStr(d, 'forma', 40)
        && optBool(d, 'recorrente');
    }

    function isValidCompra(d) {
      return optStr(d, 'id', 128)
        && optNum(d, 'ts')
        && optStr(d, 'fornecedor', 120)
        && optStr(d, 'fornecedorId', 128)
        && optList(d, 'itens', 100)
        && optNum(d, 'total')
        && optStr(d, 'forma', 40)
        && optBool(d, 'pago')
        && optNum(d, 'valorPago')
        && optNum(d, 'parcialTs')
        && optStr(d, 'obs', 500);
    }

    function isValidFornecedor(d) {
      return optStr(d, 'id', 128)
        && optNum(d, 'ts')
        && optStr(d, 'nome', 120)
        && optStr(d, 'tipo', 40)
        && optStr(d, 'telefone', 30)
        && optStr(d, 'cep', 20)
        && optStr(d, 'endereco', 200)
        && optStr(d, 'numero', 30)
        && optStr(d, 'bairro', 100)
        && optStr(d, 'cidade', 100)
        && optStr(d, 'referencia', 200)
        && optStr(d, 'produtos', 300)
        && optStr(d, 'pix', 100)
        && optStr(d, 'banco', 100)
        && optStr(d, 'agencia', 30)
        && optStr(d, 'conta', 30)
        && optStr(d, 'tipoConta', 30)
        && optStr(d, 'titular', 120)
        && optStr(d, 'docTitular', 50)
        && optStr(d, 'obs', 500);
    }

    function isValidNotificacao(d) {
      return optStr(d, 'id', 128)
        && optNum(d, 'ts')
        && optStr(d, 'tipo', 40)
        && optStr(d, 'titulo', 120)
        && optStr(d, 'texto', 400)
        && optBool(d, 'lida');
    }

    function isValidCliente(d) {
      return optStr(d, 'id', 128)
        && optNum(d, 'ts')
        && optStr(d, 'nome', 120)
        && optStr(d, 'tipo', 40)
        && optStr(d, 'telefone', 30)
        && optStr(d, 'email', 120)
        && optStr(d, 'cep', 20)
        && optStr(d, 'endereco', 200)
        && optStr(d, 'numero', 30)
        && optStr(d, 'complemento', 100)
        && optStr(d, 'bairro', 100)
        && optStr(d, 'cidade', 100)
        && optStr(d, 'referencia', 200)
        && optStr(d, 'obs', 500);
    }

    function isValidVenda(d) {
      return optStr(d, 'id', 128)
        && optNum(d, 'ts')
        && optMap(d, 'cliente')
        && optStr(d, 'clienteId', 128)
        && optList(d, 'itens', 100)
        && optNum(d, 'total')
        && optStr(d, 'forma', 40)
        && optBool(d, 'pago')
        && optNum(d, 'pagoTs')
        && optNum(d, 'valorPago')
        && optNum(d, 'parcialTs')
        && optStr(d, 'origem', 40)
        && optStr(d, 'status', 40)
        && optNum(d, 'ordemRota')
        && optNum(d, 'entregueTs')
        && optStr(d, 'obs', 500)
        && optBool(d, 'clienteInformouPix');
    }

    function isValidMensagem(d) {
      return optStr(d, 'id', 128)
        && optNum(d, 'ts')
        && optStr(d, 'conversaId', 128)
        && optStr(d, 'clienteId', 128)
        && optStr(d, 'de', 30)
        && optStr(d, 'texto', 2000)
        && optMap(d, 'anexo')
        && optBool(d, 'lida')
        && optBool(d, 'lidaGestao')
        && optBool(d, 'lidaCliente');
    }

    function isSaleOwner(d) {
      return isSignedIn() && (
        d.clienteId == request.auth.uid ||
        (d.cliente != null && d.cliente.id == request.auth.uid)
      );
    }

    function isMsgOwner(d) {
      return isSignedIn() && (
        d.conversaId == request.auth.uid ||
        d.clienteId == request.auth.uid
      );
    }

    function isValidConfig(d) {
      return d.keys().hasOnly(['id', 'chave', 'ts'])
        && optStr(d, 'id', 128)
        && optStr(d, 'chave', 500)
        && optNum(d, 'ts');
    }

    // ===============================================================
    // Collections
    // ===============================================================

    match /config/{configId} {
      allow get, list: if isAdmin();
      allow create, update: if isValidId(configId) && isMaster() && isValidConfig(request.resource.data);
      allow delete: if isValidId(configId) && isMaster();
    }

    match /test/{testId} {
      allow get: if isValidId(testId);
      allow list: if isAdmin();
      allow create, update: if isValidId(testId) && isAdmin();
      allow delete: if isValidId(testId) && isAdmin();
    }

    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isUser(adminId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(adminId) && (
        (isTeamManager() && isValidAdminDoc(request.resource.data)) ||
        isValidInviteClaim(adminId)
      );
      allow update: if isValidId(adminId)
        && isTeamManager()
        && isValidAdminDoc(request.resource.data)
        && (!('role' in resource.data) || resource.data.role != 'master' || request.resource.data.role == 'master');
      allow delete: if isValidId(adminId)
        && isTeamManager()
        && !isUser(adminId)
        && (!('role' in resource.data) || resource.data.role != 'master');
    }

    match /convites/{conviteId} {
      allow get: if isSignedIn() && isValidId(conviteId);
      allow list: if isTeamManager();
      allow create: if isValidId(conviteId) && isTeamManager() && isValidConvite(request.resource.data);
      allow update: if isValidId(conviteId) && (
        (isTeamManager() && isValidConvite(request.resource.data)) ||
        isValidConviteSelfClaim()
      );
      allow delete: if isValidId(conviteId) && isTeamManager();
    }

    match /usuarios/{userId} {
      allow get: if isValidId(userId) && (isUser(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isValidUsuario(request.resource.data) && (
        (isUser(userId) && request.resource.data.role == 'cliente') ||
        isTeamManager() ||
        (isUser(userId) && isAdmin() && request.resource.data.role in ['master', 'admin', 'operador'])
      );
      allow update: if isValidId(userId) && isValidUsuario(request.resource.data) && (
        isTeamManager() ||
        (isUser(userId) && request.resource.data.role == resource.data.role)
      );
      allow delete: if isValidId(userId) && isTeamManager();
    }

    match /produtos/{produtoId} {
      allow get: if isValidId(produtoId);
      allow list: if true;
      allow create, update: if isValidId(produtoId) && isAdmin() && isValidProduto(request.resource.data);
      allow delete: if isValidId(produtoId) && isAdmin();
    }

    match /noticias/{noticiaId} {
      allow get: if isValidId(noticiaId);
      allow list: if true;
      allow create, update: if isValidId(noticiaId) && isAdmin() && isValidNoticia(request.resource.data);
      allow delete: if isValidId(noticiaId) && isAdmin();
    }

    match /categorias/{categoriaId} {
      allow get: if isValidId(categoriaId) && isAdmin();
      allow list: if isAdmin();
      allow create, update: if isValidId(categoriaId) && isAdmin() && isValidCategoria(request.resource.data);
      allow delete: if isValidId(categoriaId) && isAdmin();
    }

    match /despesas/{despesaId} {
      allow get: if isValidId(despesaId) && isAdmin();
      allow list: if isAdmin();
      allow create, update: if isValidId(despesaId) && isAdmin() && isValidDespesa(request.resource.data);
      allow delete: if isValidId(despesaId) && isAdmin();
    }

    match /compras/{compraId} {
      allow get: if isValidId(compraId) && isAdmin();
      allow list: if isAdmin();
      allow create, update: if isValidId(compraId) && isAdmin() && isValidCompra(request.resource.data);
      allow delete: if isValidId(compraId) && isAdmin();
    }

    match /fornecedores/{fornecedorId} {
      allow get: if isValidId(fornecedorId) && isAdmin();
      allow list: if isAdmin();
      allow create, update: if isValidId(fornecedorId) && isAdmin() && isValidFornecedor(request.resource.data);
      allow delete: if isValidId(fornecedorId) && isAdmin();
    }

    match /notificacoes/{notificacaoId} {
      allow get: if isValidId(notificacaoId) && isAdmin();
      allow list: if isAdmin();
      allow create, update: if isValidId(notificacaoId) && isAdmin() && isValidNotificacao(request.resource.data);
      allow delete: if isValidId(notificacaoId) && isAdmin();
    }

    match /clientes/{clienteId} {
      allow get: if isValidId(clienteId) && (isAdmin() || isUser(clienteId));
      allow list: if isAdmin();
      allow create, update: if isValidId(clienteId) && (isAdmin() || isUser(clienteId)) && isValidCliente(request.resource.data);
      allow delete: if isValidId(clienteId) && isAdmin();
    }

    match /vendas/{vendaId} {
      allow get: if isValidId(vendaId) && (isAdmin() || isSaleOwner(resource.data));
      allow list: if isAdmin() || (isSignedIn() && resource.data.clienteId == request.auth.uid);
      allow create: if isValidId(vendaId) && isValidVenda(request.resource.data) && (
        isAdmin() ||
        (isSignedIn() && request.resource.data.clienteId == request.auth.uid && request.resource.data.total is number && request.resource.data.total >= 0)
      );
      allow update: if isValidId(vendaId) && (
        (isAdmin() && isValidVenda(request.resource.data)) ||
        (isSaleOwner(resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clienteInformouPix']) && request.resource.data.clienteInformouPix is bool)
      );
      allow delete: if isValidId(vendaId) && isAdmin();
    }

    match /mensagens/{mensagemId} {
      allow get: if isValidId(mensagemId) && (isAdmin() || isMsgOwner(resource.data));
      allow list: if isAdmin() || (isSignedIn() && (resource.data.conversaId == request.auth.uid || resource.data.clienteId == request.auth.uid));
      allow create: if isValidId(mensagemId) && isValidMensagem(request.resource.data) && (
        isAdmin() || (
          isSignedIn()
          && (request.resource.data.conversaId == request.auth.uid || request.resource.data.clienteId == request.auth.uid)
          && request.resource.data.de == 'cliente'
        )
      );
      allow update: if isValidId(mensagemId) && (
        (isAdmin() && isValidMensagem(request.resource.data)) ||
        (isMsgOwner(resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lidaCliente']) && request.resource.data.lidaCliente == true)
      );
      allow delete: if isValidId(mensagemId) && isAdmin();
    }
  }
}
